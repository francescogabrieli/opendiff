{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendiff.local/schema/review-2.0.json",
  "title": "OpenDiff review",
  "description": "Agent-authored narrative and references for a local OpenDiff guided review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "review", "git", "stats", "sections", "tests", "risks", "assumptions", "completion"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "2.0"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "originalTask", "generatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "originalTask": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRef", "baseCommit", "targetRef", "includeStaged", "includeUnstaged", "includeUntracked"],
      "properties": {
        "baseRef": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "includeStaged": { "type": "boolean" },
        "includeUnstaged": { "type": "boolean" },
        "includeUntracked": { "type": "boolean" },
        "fingerprint": { "type": "string" },
        "initialWorkingTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean", "preExistingChanges"],
          "properties": {
            "clean": { "type": "boolean" },
            "preExistingChanges": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesChanged", "additions", "deletions"],
      "properties": {
        "filesChanged": { "type": "integer", "minimum": 0 },
        "filesAdded": { "type": "integer", "minimum": 0 },
        "filesModified": { "type": "integer", "minimum": 0 },
        "filesDeleted": { "type": "integer", "minimum": 0 },
        "filesRenamed": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 },
        "testsChanged": { "type": "integer", "minimum": 0 }
      }
    },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "design": { "$ref": "#/$defs/design" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "notExecuted"],
      "properties": {
        "executed": { "type": "array", "items": { "$ref": "#/$defs/executedTest" } },
        "notExecuted": { "type": "array", "items": { "$ref": "#/$defs/notExecutedTest" } }
      }
    },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "remainingWork"],
      "properties": {
        "status": { "enum": ["complete", "partial", "blocked"] },
        "summary": { "type": "string" },
        "remainingWork": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "2.0" } } },
      "then": { "required": ["design"] }
    }
  ],
  "$defs": {
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "kind", "newLines", "oldLines", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "kind": { "enum": ["primary", "secondary", "test"] },
        "newLines": { "$ref": "#/$defs/lineRange" },
        "oldLines": { "oneOf": [{ "$ref": "#/$defs/lineRange" }, { "type": "null" }] },
        "description": { "type": "string", "minLength": 1 },
        "resolved": { "type": "boolean" },
        "resolutionError": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "title", "description"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "relatedReferences": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "executedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "summary": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 },
        "supports": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "notExecutedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "enum": ["code", "test", "benchmark", "manual", "design"] },
        "description": { "type": "string", "minLength": 1 },
        "referenceId": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "desiredOutcome", "nonGoals", "decisions", "invariants", "acceptanceCriteria", "deviations"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "desiredOutcome": { "type": "string", "minLength": 1 },
        "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "rationale", "alternatives", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "status": { "enum": ["accepted", "revised"] }
            }
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "importance"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "importance": { "enum": ["must", "should"] }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "status", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "status": { "enum": ["verified", "unverified"] },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "verified" } } },
                "then": { "properties": { "evidence": { "minItems": 1 } } }
              }
            ]
          }
        },
        "deviations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "shortDescription", "purpose", "explanation", "impact", "references"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1 },
        "explanation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "impact": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
        "relatedTests": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

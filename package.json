{
  "name": "@francescogabrieli/opendiff",
  "version": "0.2.1",
  "type": "module",
  "description": "Local, guided code reviews for changes made by coding agents.",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "code-review",
    "developer-tools",
    "diff",
    "git",
    "local-first"
  ],
  "homepage": "https://github.com/francescogabrieli/opendiff#readme",
  "bugs": {
    "url": "https://github.com/francescogabrieli/opendiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescogabrieli/opendiff.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "bin/",
    "cli/",
    "dist/index.html",
    "dist/assets/",
    "docs/",
    "examples/",
    "schemas/",
    "skills/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "opendiff": "bin/opendiff.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run check",
    "opendiff": "node ./cli/opendiff.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}

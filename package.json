{
  "name": "opendiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local guided review renderer for coding-agent changes.",
  "bin": {
    "agent-diffs": "./cli/index.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "agent-diffs": "node ./cli/index.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@vitejs/plugin-react": "^5.0.0",
    "commander": "^15.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.1",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
